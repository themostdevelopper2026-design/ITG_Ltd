# backend/.env.example — Template des variables d'environnement
# Copier ce fichier en .env et remplir avec vos vraies valeurs
# IMPORTANT : Ne jamais committer le fichier .env dans Git !

APP_NAME="ITG Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/ITG_Group/backend/public

# ──────────────────────────────────────────────
# Base de données MySQL (XAMPP)
# ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=itg_platform
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ──────────────────────────────────────────────
# Cache & Sessions
# ──────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ──────────────────────────────────────────────
# File Storage
# ──────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────
# Mail (optionnel — pour les notifications)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@itg-limited.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Queue (optionnel)
# ──────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ──────────────────────────────────────────────
# CORS — Frontend autorisé à appeler l'API
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost
